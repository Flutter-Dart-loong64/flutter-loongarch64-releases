diff --git a/flutter/lib/ui/semantics/semantics_flags.cc b/flutter/lib/ui/semantics/semantics_flags.cc
new file mode 100644
index 0000000..4ec5310
--- /dev/null
+++ b/flutter/lib/ui/semantics/semantics_flags.cc
@@ -0,0 +1,138 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/lib/ui/semantics/semantics_flags.h"
+
+#include "flutter/lib/ui/semantics/semantics_node.h"
+#include "flutter/lib/ui/ui_dart_state.h"
+#include "third_party/tonic/dart_binding_macros.h"
+
+namespace flutter {
+namespace {
+
+enum class SemanticsTristate : int32_t {
+  kNone = 0,
+  kTrue = 1,
+  kFalse = 2,
+};
+
+enum class SemanticsCheckState : int32_t {
+  kNone = 0,
+  kTrue = 1,
+  kFalse = 2,
+  kMixed = 3,
+};
+
+int32_t Flag(SemanticsFlags flag) {
+  return static_cast<int32_t>(flag);
+}
+
+void EncodeTristate(int value,
+                    SemanticsFlags has_flag,
+                    SemanticsFlags true_flag,
+                    int32_t* flags) {
+  if (value == static_cast<int32_t>(SemanticsTristate::kNone)) {
+    return;
+  }
+  *flags |= Flag(has_flag);
+  if (value == static_cast<int32_t>(SemanticsTristate::kTrue)) {
+    *flags |= Flag(true_flag);
+  }
+}
+
+void EncodeBool(bool value, SemanticsFlags flag, int32_t* flags) {
+  if (value) {
+    *flags |= Flag(flag);
+  }
+}
+
+}  // namespace
+
+IMPLEMENT_WRAPPERTYPEINFO(ui, NativeSemanticsFlags);
+
+NativeSemanticsFlags::NativeSemanticsFlags() = default;
+
+NativeSemanticsFlags::~NativeSemanticsFlags() = default;
+
+void NativeSemanticsFlags::initSemanticsFlags(
+    Dart_Handle semantics_flags_handle,
+    int isChecked,
+    int isSelected,
+    int isEnabled,
+    int isToggled,
+    int isExpanded,
+    int isRequired,
+    int isFocused,
+    bool isButton,
+    bool isTextField,
+    bool isInMutuallyExclusiveGroup,
+    bool isHeader,
+    bool isObscured,
+    bool scopesRoute,
+    bool namesRoute,
+    bool isHidden,
+    bool isImage,
+    bool isLiveRegion,
+    bool hasImplicitScrolling,
+    bool isMultiline,
+    bool isReadOnly,
+    bool isLink,
+    bool isSlider,
+    bool isKeyboardKey,
+    bool isAccessibilityFocusBlocked) {
+  (void)isRequired;
+  (void)isAccessibilityFocusBlocked;
+  UIDartState::ThrowIfUIOperationsProhibited();
+
+  int32_t flags = 0;
+  if (isChecked != static_cast<int32_t>(SemanticsCheckState::kNone)) {
+    flags |= Flag(SemanticsFlags::kHasCheckedState);
+    if (isChecked == static_cast<int32_t>(SemanticsCheckState::kTrue)) {
+      flags |= Flag(SemanticsFlags::kIsChecked);
+    } else if (isChecked ==
+               static_cast<int32_t>(SemanticsCheckState::kMixed)) {
+      flags |= Flag(SemanticsFlags::kIsCheckStateMixed);
+    }
+  }
+  EncodeTristate(isSelected, SemanticsFlags::kHasSelectedState,
+                 SemanticsFlags::kIsSelected, &flags);
+  EncodeTristate(isEnabled, SemanticsFlags::kHasEnabledState,
+                 SemanticsFlags::kIsEnabled, &flags);
+  EncodeTristate(isToggled, SemanticsFlags::kHasToggledState,
+                 SemanticsFlags::kIsToggled, &flags);
+  EncodeTristate(isExpanded, SemanticsFlags::kHasExpandedState,
+                 SemanticsFlags::kIsExpanded, &flags);
+  if (isFocused == static_cast<int32_t>(SemanticsTristate::kTrue)) {
+    flags |= Flag(SemanticsFlags::kIsFocused);
+  }
+
+  EncodeBool(isButton, SemanticsFlags::kIsButton, &flags);
+  EncodeBool(isTextField, SemanticsFlags::kIsTextField, &flags);
+  EncodeBool(isInMutuallyExclusiveGroup,
+             SemanticsFlags::kIsInMutuallyExclusiveGroup, &flags);
+  EncodeBool(isHeader, SemanticsFlags::kIsHeader, &flags);
+  EncodeBool(isObscured, SemanticsFlags::kIsObscured, &flags);
+  EncodeBool(scopesRoute, SemanticsFlags::kScopesRoute, &flags);
+  EncodeBool(namesRoute, SemanticsFlags::kNamesRoute, &flags);
+  EncodeBool(isHidden, SemanticsFlags::kIsHidden, &flags);
+  EncodeBool(isImage, SemanticsFlags::kIsImage, &flags);
+  EncodeBool(isLiveRegion, SemanticsFlags::kIsLiveRegion, &flags);
+  EncodeBool(hasImplicitScrolling, SemanticsFlags::kHasImplicitScrolling,
+             &flags);
+  EncodeBool(isMultiline, SemanticsFlags::kIsMultiline, &flags);
+  EncodeBool(isReadOnly, SemanticsFlags::kIsReadOnly, &flags);
+  EncodeBool(isLink, SemanticsFlags::kIsLink, &flags);
+  EncodeBool(isSlider, SemanticsFlags::kIsSlider, &flags);
+  EncodeBool(isKeyboardKey, SemanticsFlags::kIsKeyboardKey, &flags);
+
+  auto native_semantics_flags = fml::MakeRefCounted<NativeSemanticsFlags>();
+  native_semantics_flags->flags_ = flags;
+  native_semantics_flags->AssociateWithDartWrapper(semantics_flags_handle);
+}
+
+int32_t NativeSemanticsFlags::GetFlags() const {
+  return flags_;
+}
+
+}  // namespace flutter
