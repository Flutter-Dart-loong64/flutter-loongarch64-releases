# Flutter Engine old-world LoongArch64 support patch
#
# Apply from the engine checkout root (the directory containing build/ and flutter/):
#   patch -p1 < oldworld-loongarch64-engine.patch
#
# This patch contains source/build-system compatibility changes needed to build
# Flutter Engine on old-world LoongArch64 systems where the toolchain exposes
# loongarch64 with the /lib64/ld.so.1 dynamic linker and no LSX/LASX compiler flags.

--- a/build/config/BUILDCONFIG.gn
+++ b/build/config/BUILDCONFIG.gn
@@ -190,6 +190,8 @@
 # aix or one of the BSDs. If you need to check these, just check the
 # current_os value directly.
 
+is_qnx = false
+
 if (current_os == "win") {
   is_android = false
   is_chromeos = false
--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -577,8 +577,15 @@
   # gen_snapshot) where this is not supported.
   if (is_linux) {
     if (!use_flutter_cxx) {
-      cflags_cc += [ "-stdlib=libstdc++" ]
-      ldflags += [ "-stdlib=libstdc++" ]
+      if (is_clang) {
+        cflags_cc += [ "-stdlib=libstdc++" ]
+        ldflags += [ "-stdlib=libstdc++" ]
+      } else {
+        ldflags += [
+          "-static-libstdc++",
+          "-static-libgcc",
+        ]
+      }
       libs += [ "gcc" ]
     }
   }
@@ -636,7 +643,6 @@
   default_warning_flags += [
     # Enables.
     "-Wendif-labels",  # Weird old-style text after an #endif.
-    "-Werror",  # Warnings as errors.
 
     # Disables.
     "-Wno-missing-field-initializers",  # "struct foo f = {0};"
@@ -654,6 +660,12 @@
     ]
   }
 
+  if (is_clang) {
+    default_warning_flags += [ "-Werror" ]
+  } else {
+    default_warning_flags += [ "-Wno-attributes" ]
+  }
+
   default_warning_flags += [
     "-Wno-unused-but-set-parameter",
     "-Wno-unused-but-set-variable",
